# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA commite o arquivo `.env` com segredos reais.

# ── PostgreSQL — Supabase (integração Vercel) ────────────────
# Runtime: POSTGRES_PRISMA_URL (pooler Supabase).
# Migrations / CLI: POSTGRES_URL_NON_POOLING (host db.<ref>.supabase.co, sem pooler).
# A integração Supabase na Vercel injeta esses nomes automaticamente.
#
# sslmode=verify-full: cifra + valida CA e hostname. O app confia na CA em certs/.
# NÃO use NODE_TLS_REJECT_UNAUTHORIZED=0.
POSTGRES_PRISMA_URL="postgresql://user:password@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=verify-full"
POSTGRES_URL_NON_POOLING="postgresql://user:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=verify-full"

# NextAuth / Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Bootstrap do primeiro administrador (usado SOMENTE se a tabela User estiver vazia).
# Depois do primeiro usuário, o login autentica pelo hash no banco — não por estas vars.
ADMIN_EMAIL="admin@allativajoias.com"
ADMIN_PASSWORD="uma-senha-forte"

# ── Vercel Blob (upload de imagens dos produtos) ─────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
