# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA commite o arquivo `.env` com segredos reais.

# ── PostgreSQL (Prisma) ──────────────────────────────────────
# O schema.prisma lê ESTAS duas variáveis (não DATABASE_URL).
# Local / migrations: conexão DIRETA (sem "-pooler" / sem "pooler.supabase") em
# POSTGRES_URL_NON_POOLING. Runtime pode usar a pooled em POSTGRES_PRISMA_URL.
# Vercel Postgres e Supabase injeta os nomes abaixo automaticamente.
#
# sslmode=verify-full: cifra + valida CA e hostname. O app também confia na CA
# pública do provedor (certs/). NÃO use NODE_TLS_REJECT_UNAUTHORIZED=0.
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# Alias opcional para ferramentas que esperam DATABASE_URL (Prisma CLI em alguns contextos).
# Não é lido pelo schema.prisma atual.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# Opcional: PEM extra da CA (Dashboard do provedor) se diferir da CA já versionada.
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----..."
# PGSSLROOTCERT="C:/caminho/para/ca.pem"

# NextAuth / Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Bootstrap do primeiro administrador (usado SOMENTE se a tabela User estiver vazia).
# Depois do primeiro usuário, o login autentica pelo hash no banco — não por estas vars.
ADMIN_EMAIL="admin@allativajoias.com"
ADMIN_PASSWORD="uma-senha-forte"

# Vercel Blob (upload de imagens dos produtos)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
