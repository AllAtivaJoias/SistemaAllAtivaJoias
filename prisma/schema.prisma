// Prisma schema — AllAtiva Joias
// Banco: PostgreSQL.
// Conexão: POSTGRES_PRISMA_URL (pooled) + POSTGRES_URL_NON_POOLING (direta).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // CLI / migrations: POSTGRES_PRISMA_URL (pooled) + POSTGRES_URL_NON_POOLING (direta).
  // Runtime: driver adapter em lib/prisma.ts (pool `pg` via lib/pg-pool.ts).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Precisão monetária e física ──────────────────────────────
// MONEY_2   Decimal(14,2)  totais em BRL (centavos)
// MONEY_4   Decimal(14,4)  preços unitários (R$/g, R$/cm, R$/un)
// QTY_4     Decimal(14,4)  pesos, quantidades, mm
// PURITY_6  Decimal(8,6)   teor 0–1 (ex.: 0.750000)

enum UserRole {
  ADMIN
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(ADMIN)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  aiPrompts    AiPrompt[]

  @@index([email])
  @@index([isActive])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([order])
}

/// Configuração global da vitrine (singleton: id fixo "singleton").
model StoreSettings {
  id           String   @id @default("singleton")
  heroTitle    String   @default("")
  heroSubtitle String   @default("")
  footerText   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String                   @id @default(cuid())
  title            String
  description      String
  imageUrl         String
  price            Decimal                  @db.Decimal(14, 2)
  costPrice        Decimal                  @default(0) @db.Decimal(14, 2)
  isAvailable      Boolean                  @default(true)
  isDeleted        Boolean                  @default(false)
  isFeatured       Boolean                  @default(false)
  productCode      String?                  @unique
  totalWeightG     Decimal?                 @db.Decimal(14, 4)
  pricingStrategy  String?
  pricingValue     Decimal?                 @db.Decimal(14, 4)
  version          Int                      @default(0)
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  compositionItems CompositionItem[]
  additionalCosts  ProductAdditionalCost[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([categoryId])
  @@index([title])
  @@index([isAvailable])
  @@index([isDeleted])
  @@index([isDeleted, isAvailable])
  @@index([categoryId, title])
  // Vitrine: destaques por categoria (limite de 4) e filtros de publicação.
  @@index([categoryId, isFeatured, isDeleted, isAvailable])
}

model ProductAdditionalCost {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  kind        String // fixed | percent
  value       Decimal  @db.Decimal(14, 4)
  isPackaging Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
}

model Material {
  id               String            @id @default(cuid())
  name             String            @unique
  type             String            @default("metal")
  purchasePrice    Decimal           @db.Decimal(14, 4)
  purchaseQuantity Decimal           @db.Decimal(14, 4)
  unit             String
  attrCut          String?
  attrColor        String?
  attrSizeMm       Decimal?          @db.Decimal(14, 4)
  attrLengthMm     Decimal?          @db.Decimal(14, 4)
  attrMaterial     String?
  attrMesh         String?
  attrProfile      String?
  attrGauge        Decimal?          @db.Decimal(14, 4)
  weightPerCm      Decimal?          @db.Decimal(14, 4)
  purity           Decimal?          @db.Decimal(8, 6)
  pureMetalName    String?
  alloyMetalName   String?
  compositionItems CompositionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([type])
  @@index([attrCut])
  @@index([attrColor])
  @@index([attrMaterial])
  @@index([attrProfile])
}

model CompositionItem {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantityUsed    Decimal        @db.Decimal(14, 4)
  sequenceOrder   Int            @default(0)
  lineKind        String         @default("outro")
  sourcePatternId String?
  sourcePattern   SupplyPattern? @relation(fields: [sourcePatternId], references: [id], onDelete: SetNull)
  patternQty      Decimal?       @db.Decimal(14, 4)
  createdAt       DateTime       @default(now())

  @@unique([productId, materialId])
  @@index([productId])
  @@index([materialId])
  @@index([productId, sequenceOrder])
  @@index([sourcePatternId])
}

model Stone {
  id           String              @id @default(cuid())
  name         String
  cut          String              @default("brilhante")
  color        String              @default("branco")
  widthMm      Decimal?            @db.Decimal(14, 4)
  lengthMm     Decimal?            @db.Decimal(14, 4)
  weightCt     Decimal             @default(0) @db.Decimal(14, 4)
  unitPrice    Decimal             @default(0) @db.Decimal(14, 4)
  patternItems SupplyPatternItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([cut])
  @@index([color])
  @@index([widthMm])
  @@index([cut, color, widthMm, lengthMm])
  // Unicidade lógica (PostgreSQL): LOWER(cut), LOWER(color), widthMm, COALESCE(lengthMm, -1)
}

model Chain {
  id           String              @id @default(cuid())
  name         String
  mesh         String              @default("veneziana")
  material     String              @default("Ouro 18k")
  thicknessMm  Decimal?            @db.Decimal(14, 4)
  weightPerCm  Decimal?            @db.Decimal(14, 4)
  pricePerCm   Decimal             @default(0) @db.Decimal(14, 4)
  patternItems SupplyPatternItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([mesh])
  @@index([material])
}

model Wire {
  id           String              @id @default(cuid())
  name         String
  material     String              @default("Ouro 18k")
  profile      String              @default("redondo")
  gauge        Decimal             @default(0) @db.Decimal(14, 4)
  widthMm      Decimal?            @db.Decimal(14, 4)
  weightPerCm  Decimal?            @db.Decimal(14, 4)
  pricePerCm   Decimal             @default(0) @db.Decimal(14, 4)
  alloyId      String?
  alloy        MetalAlloy?         @relation(fields: [alloyId], references: [id], onDelete: SetNull)
  patternItems SupplyPatternItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([profile])
  @@index([material])
  @@index([gauge])
  @@index([alloyId])
  @@index([profile, material, gauge])
}

model MetalAlloy {
  id                  String              @id @default(cuid())
  name                String
  purity              Decimal             @default(0.75) @db.Decimal(8, 6)
  pureMetalName       String              @default("Ouro 24k")
  pureMetalPricePerG  Decimal             @default(0) @db.Decimal(14, 4)
  alloyMetalName      String              @default("Pré-liga (Prata/Cobre)")
  alloyMetalPricePerG Decimal             @default(0) @db.Decimal(14, 4)
  pricePerGram        Decimal             @default(0) @db.Decimal(14, 4)
  wires               Wire[]
  patternItems        SupplyPatternItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([name])
}

model SupplyPattern {
  id               String              @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean             @default(true)
  items            SupplyPatternItem[]
  compositionItems CompositionItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([name])
  @@index([isActive])
}

model SupplyPatternItem {
  id            String        @id @default(cuid())
  patternId     String
  pattern       SupplyPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  itemKind      String
  sequenceOrder Int           @default(0)
  quantity      Decimal       @db.Decimal(14, 4)
  stoneId       String?
  stone         Stone?        @relation(fields: [stoneId], references: [id], onDelete: Restrict)
  alloyId       String?
  alloy         MetalAlloy?   @relation(fields: [alloyId], references: [id], onDelete: Restrict)
  chainId       String?
  chain         Chain?        @relation(fields: [chainId], references: [id], onDelete: Restrict)
  wireId        String?
  wire          Wire?         @relation(fields: [wireId], references: [id], onDelete: Restrict)
  notes         String?

  @@index([patternId, sequenceOrder])
  @@index([stoneId])
  @@index([alloyId])
  @@index([chainId])
  @@index([wireId])
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  customerPhone  String?
  sellerName     String?     @map("waiterName")
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(14, 2)
  advancePayment Decimal     @default(0) @db.Decimal(14, 2)
  version        Int         @default(0)
  cancelledAt    DateTime?
  cancelReason   String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  priceAtTime  Decimal             @db.Decimal(14, 2)
  costAtTime   Decimal             @default(0) @db.Decimal(14, 2)
  productTitle String
  productCode  String?
  bomLines     OrderItemBomLine[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Snapshot imutável da BOM no momento da venda.
model OrderItemBomLine {
  id            String    @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name          String
  type          String
  unit          String
  quantityUsed  Decimal   @db.Decimal(14, 4)
  attrCut       String?
  attrColor     String?
  attrSizeMm    Decimal?  @db.Decimal(14, 4)
  attrLengthMm  Decimal?  @db.Decimal(14, 4)
  attrMaterial  String?
  attrMesh      String?
  attrProfile   String?
  attrGauge     Decimal?  @db.Decimal(14, 4)
  weightPerCm   Decimal?  @db.Decimal(14, 4)
  purity        Decimal?  @db.Decimal(8, 6)
  pureMetalName String?
  alloyMetalName String?

  @@index([orderItemId])
}

// ── Biblioteca de Prompts de IA ──────────────────────────────
/// Taxonomia da biblioteca (ex.: Pulseiras, Anéis). Independente de Category
/// do catálogo de produtos — finalidades de conteúdo, não de estoque.
model AiPromptCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  prompts     AiPrompt[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([order])
  @@index([isActive])
}

/// Finalidade de uso (ex.: Imagem de Catálogo, Redes Sociais).
model AiPromptPurpose {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  prompts     AiPrompt[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([order])
  @@index([isActive])
}

model AiPromptTag {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  prompts   AiPromptOnTag[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// Junção explícita: permite evoluir (ex.: origem da tag) sem migrar implicit.
model AiPromptOnTag {
  promptId String
  tagId    String
  prompt   AiPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag      AiPromptTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@index([tagId])
}

model AiPrompt {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  content     String           @db.Text
  categoryId  String
  category    AiPromptCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purposeId   String
  purpose     AiPromptPurpose  @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  /// Ferramenta alvo (ChatGPT, Midjourney, …). String controlada na aplicação.
  tool        String           @default("")
  language    String           @default("pt-BR")
  /// Nomes das variáveis `{IDENT}` extraídas de `content` na gravação.
  variables   String[]         @default([])
  isFavorite  Boolean          @default(false)
  isActive    Boolean          @default(true)
  usageCount  Int              @default(0)
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags        AiPromptOnTag[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([purposeId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isFavorite])
  @@index([isActive])
  @@index([tool])
  @@index([usageCount])
  @@index([authorId])
  @@index([isActive, createdAt])
  @@index([isActive, isFavorite, createdAt])
}
